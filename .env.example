# ==============================================================================
# Backend (FastAPI / Railway)
# ==============================================================================

# Orígenes permitidos por CORS (separados por comas, sin barra final)
ALLOWED_ORIGINS=http://localhost:5173

# Puerto del servidor HTTP (Railway inyecta PORT dinámicamente en producción)
PORT=3000

# Ruta al checkpoint YOLOv9-S (las rutas relativas se resuelven respecto a BASE_DIR en main.py)
MODEL_PATH=best.pt

# Umbral mínimo de confianza para detecciones (0.0 a 1.0)
CONF_THRESHOLD=0.25

# Resolución cuadrada de entrada para la inferencia de YOLOv9-S
IMGSZ=640

# ==============================================================================
# Frontend (Vite / Vercel)
# ==============================================================================

# URL base del backend FastAPI (sin barra final)
VITE_API_URL=http://localhost:3000
